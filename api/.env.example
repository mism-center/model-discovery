DEPLOY_TYPE=local
LOG_LEVEL=INFO

SEARCH_SERVICE_URL=http://localhost:8100
UPLOAD_SERVICE_URL=http://localhost:8200
SEARCH_TIMEOUT_SECONDS=10.0
UPLOAD_TIMEOUT_SECONDS=60.0

UPLOAD_CHUNK_SIZE_BYTES=5242880
UPLOAD_RETRY_MAX_ATTEMPTS=3
UPLOAD_RETRY_BACKOFF_SECONDS=1.0
UPLOAD_RETRY_TRAILING_BUFFER_BYTES=15728640

AUTH_MODE=oidc
STUB_UPSTREAM_SERVICES=False

OIDC_ISSUER_URL=https://issuer.example.com
OIDC_DISCOVERY_URL=https://issuer.example.com/.well-known/openid-configuration
OIDC_AUDIENCE=discovery-api
OIDC_REQUIRED_SCOPES=openid
OIDC_JWKS_TTL_SECONDS=300
OIDC_CLIENT_ID=discovery-api
OIDC_CLIENT_SECRET=my-secret-key
OIDC_REDIRECT_URI=http://localhost:8000/api/auth/callback
OIDC_POST_LOGIN_REDIRECT_URI=http://localhost:3000
OIDC_POST_LOGOUT_REDIRECT_URI=http://localhost:3000/logout
OIDC_COOKIE_SIGNING_SECRET=my-other-secret-key

REDIS_URL=redis://localhost:6379/0
SESSION_TTL_SECONDS=3600
SESSION_COOKIE_NAME=mism_session
OAUTH_STATE_COOKIE_NAME=mism_oauth_state
OAUTH_STATE_COOKIE_MAX_AGE_SECONDS=600

PRODUCTION_MODE=False
